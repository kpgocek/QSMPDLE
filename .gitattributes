# Normalize to LF in the repository; check out with the platform default
* text=auto

# C# sources match .editorconfig (end_of_line = crlf) on every OS, including CI
*.cs        text eol=crlf diff=csharp
*.razor     text eol=crlf
*.cshtml    text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf

# Binary assets
*.webp      binary
*.png       binary
*.jpg       binary
*.ico       binary
*.gif       binary
*.ttf       binary
*.woff      binary
*.woff2     binary
*.gz        binary
*.br        binary
*.db        binary
