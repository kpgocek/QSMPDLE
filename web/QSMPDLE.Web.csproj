<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <!-- Railpack restores with only this file present, so the SDK cannot see .razor files and would
         skip the package that serves _framework/blazor.web.js; request it explicitly. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
    <NuGetAudit>True</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <UserSecretsId>df25ea81-75bc-4426-8875-5fe2836fa84d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
	<!-- Blazor & UI-->
	<PackageReference Include="Blazor.LocalStorage" Version="10.1.0" />

	<!-- EF Core & PostgreSQL -->
	<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
	<PackageReference Include="MudBlazor" Version="9.11.0" />
	<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

	<!-- Analyzers -->
	<PackageReference Include="Roslynator.Analyzers" Version="4.15.0" />
	<PackageReference Include="Roslynator.Formatting.Analyzers" Version="4.15.0" />
  </ItemGroup>
	
</Project>
