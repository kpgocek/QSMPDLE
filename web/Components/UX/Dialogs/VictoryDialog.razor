@using MudBlazor
@using QSMPDLE.Web.Features.Gameplay.Models
@using QSMPDLE.Web.Features.Sharing.Builders
@using QSMPDLE.Web.Features.Sharing.Services
@using QSMPDLE.Web.Features.Statistics.Models
@using QSMPDLE.Web.Features.Statistics.Services
@inject IShareService ShareService
@inject IShareTextBuilder ShareTextBuilder
@inject IStatisticsService StatisticsService
@inject ILogger<VictoryDialog> Logger

<div class="victory-overlay" @onkeydown="CloseOnEscape">
    @* Focus sentinels keep Tab inside the dialog, so Escape keeps reaching the overlay's handler. *@
    <div tabindex="0" @onfocus="FocusModalAsync"></div>
    <div class="victory-modal" role="dialog" aria-modal="true" aria-labelledby="victory-title"
         tabindex="-1" @ref="modal">

        <h2 id="victory-title">Correct!</h2>

        @if (DayNumber is not null)
        {
            <p>
                You guessed character #@DayNumber in <strong>@Guesses.Count</strong> @(Guesses.Count == 1 ? "guess" : "guesses").
            </p>
        }
        else
        {
            <p>
                It took you
                @if (@Guesses.Count > 1)
                {
                    <span><strong>@Guesses.Count</strong> guesses</span>
                }
                else
                {
                    <span><strong>@Guesses.Count</strong> guess</span>
                }
                to find the right answer.
            </p>
        }

        @if (Stats is not null)
        {
            <div class="stats-popup">

                <h3>Statistics</h3>

                <div class="stats-grid">

                    <div class="stat">
                        <span class="value">@Stats.GamesPlayed</span>
                        <span class="label">Played</span>
                    </div>

                    <div class="stat">
                        <span class="value">@Math.Round(Stats.WinRate)</span>
                        <span class="label">Win %</span>
                    </div>

                    <div class="stat">
                        <span class="value">@Stats.CurrentStreak</span>
                        <span class="label">Current Streak</span>
                    </div>

                    <div class="stat">
                        <span class="value">@Stats.MaxStreak</span>
                        <span class="label">Max Streak</span>
                    </div>

                </div>

                <h4>Guess Distribution</h4>

                <div class="distribution">

                    @for (var i = 0; i < 6; i++)
                    {
                        <div class="distribution-row">
                            <span class="guess-number">@(i + 1)</span>

                            <div class="distribution-bar-container">
                                <div class="distribution-bar @(i == TodayBarIndex ? "today" : "")" style="width:@GetBarWidth(i)%">
                                    @Stats.GuessDistribution[i]
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        }
        <div class="buttons">
            @if (GameState.SessionCategory == GameModeSessionCategory)
            {
                <MudMenu Icon="@Icons.Material.Filled.Share" Variant="Variant.Filled" Color="Color.Primary" AriaLabel="Share result">

                    <MudMenuItem OnClick="Share">
                        <MudIcon Icon="@Icons.Material.Filled.Share" />
                        Share Results
                    </MudMenuItem>

                    <MudMenuItem OnClick="CopyShareText">
                        <MudIcon Icon="@Icons.Material.Filled.ContentCopy" />
                        Copy
                    </MudMenuItem>

                    <MudMenuItem Href="@BuildXLink()" Target="_blank">
                        <MudIcon Icon="@Icons.Custom.Brands.Twitter" />
                        X
                    </MudMenuItem>

                    <MudMenuItem Href="@BuildTelegramLink()" Target="_blank">
                        <MudIcon Icon="@Icons.Custom.Brands.Telegram" />
                        Telegram
                    </MudMenuItem>

                    <MudMenuItem Href="@BuildRedditLink()" Target="_blank">
                        <MudIcon Icon="@Icons.Custom.Brands.Reddit" />
                        Reddit
                    </MudMenuItem>

                </MudMenu>
            }
            <MudButton OnClick="Close">
                Close
            </MudButton>
        </div>

    </div>
    <div tabindex="0" @onfocus="FocusModalAsync"></div>
</div>

<style>
    .victory-modal:focus {
        outline: none;
    }

    .victory-overlay {
        position: fixed;
        inset: 0;

        background: rgba(1, 10, 30, .78);
        backdrop-filter: blur(.5rem);

        display: flex;
        justify-content: center;
        align-items: center;

        z-index: 10000;

        /* Waits for the final guess's clues to finish turning over before covering the board. */
        animation: overlay-enter 240ms ease-out 1000ms backwards;
    }

    .victory-modal {
        background: linear-gradient(180deg, var(--surface-strong), var(--black));
        padding: 2rem;
        border: .0625rem solid var(--line-strong);
        min-width: min(20rem, 100%);
        max-width: calc(100vw - 2rem);
        max-height: calc(100dvh - 2rem);
        overflow-y: auto;
        box-shadow: var(--soft-shadow);
        animation: modal-enter 240ms cubic-bezier(.16, 1, .3, 1) 1000ms backwards;
    }

    .victory-modal h2 {
        margin-bottom: 1rem;

        color: var(--correct);
        font-size: clamp(2.5rem, 11vw, 3.5rem);
        line-height: 1;
        text-align: center;

        animation: result-stamp 420ms cubic-bezier(.16, 1, .3, 1) 1120ms backwards;
    }

    .victory-modal p {
        text-align: center;
    }

    /* Body text is weight 300, so the browser's relative "bolder" barely differs. */
    .victory-modal p strong {
        font-weight: 800;
    }

    .buttons {
        display: flex;
        gap: 1rem;
        justify-content: end;
        margin-top: 1rem;
    }

    .stats-popup {
        min-width: min(21.25rem, 100%);
        max-width: 31.25rem;
    }

    .stats-popup h3,
    .stats-popup h4 {
        font-style: normal;
        text-align: center;
    }

    .stats-popup {
        font-variant-numeric: tabular-nums;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);

        gap: 1rem;

        margin: 1.5rem 0;
    }

    .stat {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .stat .value {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
    }

    .stat .label {
        color: var(--text-muted);
        font-size: .75rem;
        text-align: center;
    }

    .distribution {
        display: flex;
        flex-direction: column;
        gap: .5rem;
    }

    .distribution-row {
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .guess-number {
        width: 1rem;
        text-align: center;
        font-weight: 700;
    }

    .distribution-bar-container {
        flex: 1;
    }

    .distribution-bar {
        min-width: 2rem;

        padding: .25rem .5rem;

        background: var(--panel-strong);
        color: var(--white);

        font-weight: 700;
        text-align: right;
    }

    /* Only this game's bar is lit, so the player finds their result in the distribution at a glance. */
    .distribution-bar.today {
        background: var(--primary);
        color: var(--black);
    }
</style>

@code {
    [Parameter] public GameState GameState { get; set; } = null!;

    [Parameter] public GameMode GameMode { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    private PlayerStats? Stats;

    private int? DayNumber => GameState.Game.PuzzleId;
    private const SessionCategory GameModeSessionCategory = SessionCategory.CanonicalPuzzle;
    private IReadOnlyList<GuessResult> Guesses => GameState.GuessesMade;

    // Mirrors PlayerStatsProjection, which clamps guess counts into the six distribution buckets.
    private int TodayBarIndex => Math.Clamp(Guesses.Count, 1, 6) - 1;

    private async Task Share()
    {
        ArgumentNullException.ThrowIfNull(DayNumber);

        var text = ShareTextBuilder.BuildDailyResult(
            DayNumber.Value,
            Guesses);

        await ShareService.ShareAsync(text);
    }

    private ElementReference modal;

    protected override async Task OnInitializedAsync()
    {
        // Only canonical games count towards player statistics, so practice wins show none.
        if (GameState.SessionCategory != GameModeSessionCategory)
            return;

        try
        {
            Stats = await StatisticsService.GetPlayerStatsAsync();
        }
        catch (Exception exception)
        {
            // The win still deserves its dialog when statistics can't be loaded.
            Logger.LogError(exception, "Player statistics failed to load for the victory dialog");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The guess input that had focus is disabled once the game ends, so keyboard users start here.
        if (firstRender)
        {
            await modal.FocusAsync();
        }
    }

    private async Task FocusModalAsync() => await modal.FocusAsync();

    private async Task CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private double GetBarWidth(int index)
    {
        ArgumentNullException.ThrowIfNull(Stats);

        var max = Stats.GuessDistribution.Max();

        if (max == 0)
            return 8;

        return Math.Max(
            8,
            Stats.GuessDistribution[index] * 100.0 / max);
    }

    private string BuildShareText()
    {
        ArgumentNullException.ThrowIfNull(DayNumber);

        return ShareTextBuilder.BuildDailyResult(
            DayNumber.Value,
            Guesses);
    }

    private async Task CopyShareText()
    {
        await ShareService.ShareAsync(BuildShareText());
    }

    private string BuildXLink()
    {
        return $"https://twitter.com/intent/tweet?text={Uri.EscapeDataString(BuildShareText())}";
    }

    private string BuildTelegramLink()
    {
        return $"https://t.me/share/url?text={Uri.EscapeDataString(BuildShareText())}";
    }

    private string BuildRedditLink()
    {
        return $"https://reddit.com/submit?title={Uri.EscapeDataString(BuildShareText())}";
    }
}
