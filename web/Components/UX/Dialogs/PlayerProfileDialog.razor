@using MudBlazor
@using QSMPDLE.Web.Components.Statistics
@using QSMPDLE.Web.Components.UX.StatDisplay
@using QSMPDLE.Web.Features.Statistics.Models
@using QSMPDLE.Web.Features.Statistics.Services

@inject IPlayerProfileService PlayerProfileService

<MudDialog Class="pop-up pt-0">
    <DialogActions>
    </DialogActions>
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100">
            <h2 class="mb-0">Player Stats</h2>

            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" Size="Size.Medium" />
        </div>
    </TitleContent>
    <DialogContent>
        @if (loading)
        {
            <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Class="mb-4" />
        }
        else
        {
            @if (globalStats != null && DailyGamesPlayed > 0)
            {
                <div class="d-flex flex-wrap justify-center" style="gap:.5rem;">
                    <MudChip T="string" Color="@WinRateDeltaColor" Variant="Variant.Filled" Size="Size.Small">
                        Win Rate: @WinRateDeltaText
                    </MudChip>
                    @if (DailyGamesWon > 0)
                    {
                        <MudChip T="string" Color="@AvgGuessesDeltaColor" Variant="Variant.Filled" Size="Size.Small">
                            Avg Guesses: @AvgGuessesDeltaText
                        </MudChip>
                    }
                </div>
            }

            @if (playerCharacterStats is null)
            {
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">No data available yet</MudText>
            }
            else
            {
                <div class="d-flex justify-space-between gap-4 mt-4">
                    <MudCard Class="w-50">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <span class="d-flex">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />Most Guessed
                                    (Wrong)
                                </span>
                                <h3>@(playerCharacterStats.MostGuessedCharacterName ?? "-")</h3>
                            </CardHeaderContent>
                            <CardHeaderAvatar>
                                @if (playerCharacterStats.MostGuessedIconUrl is not null)
                                {
                                    <MudImage Src="@($"/graphics/guessing/{playerCharacterStats.MostGuessedIconUrl}/Head.webp")"
                                              Height="80" />
                                }
                            </CardHeaderAvatar>
                        </MudCardHeader>
                        <MudCardContent Class="pt-0">
                            @if (playerCharacterStats.MostGuessedCount > 0)
                            {
                                <MudText Color="MudBlazor.Color.Secondary">
                                    Guessed @(playerCharacterStats.MostGuessedCount)× as the wrong answer
                                </MudText>
                            }
                        </MudCardContent>
                    </MudCard>


                    <MudCard Class="w-50">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <span class="d-flex">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />Most
                                    Correctly Guessed
                                </span>
                                <h3>@(playerCharacterStats.MostCorrectlyGuessedCharacterName ?? "-")</h3>
                            </CardHeaderContent>
                            <CardHeaderAvatar>
                                @if (playerCharacterStats.MostCorrectlyGuessedIconUrl is not null)
                                {
                                    <MudImage
                                    Src="@($"/graphics/guessing/{playerCharacterStats.MostCorrectlyGuessedIconUrl}/Head.webp")"
                                    Height="80" />
                                }
                            </CardHeaderAvatar>
                        </MudCardHeader>

                        <MudCardContent Class="pt-0">
                            @if (playerCharacterStats.MostCorrectlyGuessedCount > 0)
                            {
                                <MudText Color="MudBlazor.Color.Secondary">
                                    Correctly identified @(playerCharacterStats.MostCorrectlyGuessedCount)× as the answer
                                </MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                </div>
            }

            <MudGrid Class="mt-2">


                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Puzzle Games" Delay="100" Icon="@Icons.Material.Filled.SportsEsports"
                              Value="@($"{DailyGamesPlayed}")" />
                </MudItem>

                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Puzzle Games Won" Delay="150" Icon="@Icons.Material.Filled.EmojiEvents"
                              Value="@($"{DailyGamesWon}")" />
                </MudItem>

                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Practice Games" Delay="100" Icon="@Icons.Material.Filled.SportsEsports"
                              Value="@($"{PracticeGamesFinished}")"
                              Comment="@($"{PracticeGamesStarted - PracticeGamesFinished} abandoned")" />
                </MudItem>

                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Current Streak" Delay="250" Icon="@Icons.Material.Filled.Whatshot"
                              Value="@($"{CurrentStreak}")" />
                </MudItem>




                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Practice Games Won" Delay="150" Icon="@Icons.Material.Filled.EmojiEvents"
                              Value="@($"{PracticeGamesWon}")" />
                </MudItem>

                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Best Streak" Delay="300" Icon="@Icons.Material.Filled.WorkspacePremium"
                              Value="@($"{LongestStreak}")" />
                </MudItem>





                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Puzzle Win Rate" Delay="200" Icon="@Icons.Material.Filled.LocalFireDepartment"
                              Value="@($"{DailyWinRate:0}%")" />
                </MudItem>

                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Practice Win Rate" Delay="200" Icon="@Icons.Material.Filled.LocalFireDepartment"
                              Value="@($"{FinishedPracticeWinRate:0}%")" Comment="@($"{AllPracticeWinRate:0}% of all started")" />
                </MudItem>

                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Avg Guesses" Delay="350" Icon="@Icons.Material.Filled.Tag"
                              Value="@(DailyGamesWon > 0 ? $"{AvgGuessesPerDailyWin:0.0}" : "-")"
                              Comment="The lower, the better" />
                </MudItem>

            </MudGrid>

            @if (DailyGamesWon > 0)
            {
                <MudDivider />

                <section class="mt-5">
                    <GuessDistributionChart Distribution="@GuessDistributionAsDoubles" Title="Your Guess Distribution" />
                </section>
            }
        }
    </DialogContent>
</MudDialog>

<style>
    .pop-up {
        border-radius: 0;
        background:
            radial-gradient(circle at 50% 0, var(--surface-strong), transparent 64rem), var(--black);
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private bool loading = true;

    private Guid playerId;

    private DateOnly? memberSince;

    // Daily stats
    private int DailyGamesPlayed { get; set; }
    private int DailyGamesWon { get; set; }
    private int CurrentStreak { get; set; }
    private int LongestStreak { get; set; }
    private double DailyWinRate { get; set; }
    private int ArchiveGamesPlayed { get; set; }
    private int ArchiveGamesWon { get; set; }
    private int ArchiveGamesLost { get; set; }
    private double ArchiveWinRate { get; set; }
    private int[] GuessDistribution { get; set; } = new int[6];

    private double[] GuessDistributionAsDoubles => GuessDistribution.Select(x => (double)x).ToArray();

    private double AvgGuessesPerDailyWin =>
        DailyGamesWon == 0
            ? 0
            : (double)Enumerable.Range(0, 6).Sum(i => (i + 1) * GuessDistribution[i]) / DailyGamesWon;

    // Practice stats
    private int PracticeGamesStarted { get; set; }
    private int PracticeGamesFinished { get; set; }
    private int PracticeGamesWon { get; set; }

    private double FinishedPracticeWinRate => PracticeGamesFinished == 0 ? 0 : (PracticeGamesWon * 100) /
(double)PracticeGamesFinished;
    private double AllPracticeWinRate => PracticeGamesStarted == 0 ? 0 : (PracticeGamesWon * 100) /
(double)PracticeGamesStarted;

    // Global comparison
    private GlobalStatsView? globalStats;

    // Character stats
    private PlayerCharacterStats? playerCharacterStats;

    private string PlayerTag =>
        playerId == Guid.Empty ? "#????????" : $"#{playerId:N}"[..9].ToUpperInvariant();

    private string MemberSinceText =>
        memberSince.HasValue
            ? $"Member since {memberSince.Value:MMMM d, yyyy}"
            : "New player — no games played yet";

    private double WinRateDelta => globalStats is null ? 0 : DailyWinRate - globalStats.WinRate;

    private MudBlazor.Color WinRateDeltaColor => WinRateDelta >= 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error;

    private string WinRateDeltaText =>
        globalStats is null
            ? "-"
            : WinRateDelta >= 0
                ? $"+{WinRateDelta:0.0}% vs global"
                : $"{WinRateDelta:0.0}% vs global";

    private double AvgGuessesDelta => globalStats is null ? 0 : AvgGuessesPerDailyWin - globalStats.AverageGuessesToWin;

    private MudBlazor.Color AvgGuessesDeltaColor => AvgGuessesDelta <= 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error;

    private string AvgGuessesDeltaText =>
        globalStats is null
            ? "-"
            : AvgGuessesDelta <= 0
                ? $"{-AvgGuessesDelta:0.0} fewer than global"
                : $"{AvgGuessesDelta:0.0} more than global";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;

        try
        {
            var profile = await PlayerProfileService.GetProfileAsync();
            var stats = profile.Stats;

            playerId = stats.Id;
            CurrentStreak = stats.CurrentStreak;
            LongestStreak = stats.MaxStreak;
            ArchiveGamesPlayed = stats.ArchiveGamesPlayed;
            ArchiveGamesWon = stats.ArchiveGamesWon;
            ArchiveGamesLost = stats.ArchiveGamesLost;
            ArchiveWinRate = stats.ArchiveWinRate;

            DailyGamesPlayed = profile.DailyGamesPlayed;
            DailyGamesWon = profile.DailyGamesWon;
            DailyWinRate = profile.DailyWinRate;
            GuessDistribution = profile.GuessDistribution;

            PracticeGamesStarted = profile.PracticeGamesStarted;
            PracticeGamesFinished = profile.PracticeGamesFinished;
            PracticeGamesWon = profile.PracticeGamesWon;

            memberSince = profile.MemberSince;
            globalStats = profile.GlobalStats;
            playerCharacterStats = profile.CharacterStats;
        }
        finally
        {
            loading = false;
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
