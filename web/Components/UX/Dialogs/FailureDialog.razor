@using MudBlazor
@using QSMPDLE.Web.Features.Gameplay.Models
@using QSMPDLE.Web.Features.Sharing.Services
@using QSMPDLE.Web.Features.Sharing.Builders
@inject IJSRuntime JS
@inject IShareService ShareService
@inject IShareTextBuilder ShareTextBuilder

<div class="failure-overlay" @onkeydown="CloseOnEscape">
    @* Focus sentinels keep Tab inside the dialog, so Escape keeps reaching the overlay's handler. *@
    <div tabindex="0" @onfocus="FocusModalAsync"></div>
    <div class="failure-modal" role="dialog" aria-modal="true" aria-labelledby="failure-title"
         tabindex="-1" @ref="modal">

        <h2 id="failure-title">Unlucky!</h2>
        @if (DayNumber is not null)
        {
            <p>
                You've reached the limit trying to guess character #@DayNumber.
            </p>
        }
        else
        {
            <p>
                You've reached the maximum number of guesses. Try again?
            </p>
        }

        <div class="buttons">
            @if (GameState.SessionCategory == GameModeSessionCategory)
            {
            <MudMenu Icon="@Icons.Material.Filled.Share" Variant="Variant.Filled" Color="Color.Primary" AriaLabel="Share result">

                <MudMenuItem OnClick="Share">
                    <MudIcon Icon="@Icons.Material.Filled.Share" />
                    Challenge Others
                </MudMenuItem>

                <MudMenuItem OnClick="CopyShareText">
                    <MudIcon Icon="@Icons.Material.Filled.ContentCopy" />
                    Copy
                </MudMenuItem>

                <MudMenuItem Href="@BuildXLink()" Target="_blank">
                    <MudIcon Icon="@Icons.Custom.Brands.Twitter" />
                    X
                </MudMenuItem>

                <MudMenuItem Href="@BuildTelegramLink()" Target="_blank">
                    <MudIcon Icon="@Icons.Custom.Brands.Telegram" />
                    Telegram
                </MudMenuItem>

                <MudMenuItem Href="@BuildRedditLink()" Target="_blank">
                    <MudIcon Icon="@Icons.Custom.Brands.Reddit" />
                    Reddit
                </MudMenuItem>

            </MudMenu>
            }

            <MudButton OnClick="Close">
                Close
            </MudButton>
        </div>

    </div>
    <div tabindex="0" @onfocus="FocusModalAsync"></div>
</div>

<style>
    .failure-modal:focus {
        outline: none;
    }

    .failure-overlay {
        position: fixed;
        inset: 0;

        background: rgba(1, 10, 30, .78);
        backdrop-filter: blur(.5rem);

        display: flex;
        justify-content: center;
        align-items: center;

        z-index: 10000;

        /* Waits for the final guess's clues to finish turning over before covering the board. */
        animation: overlay-enter 240ms ease-out 1150ms backwards;
    }

    .failure-modal {
        background: linear-gradient(180deg, var(--surface-strong), var(--black));
        padding: 2rem;
        border: .0625rem solid var(--line-strong);
        min-width: min(20rem, 100%);
        max-width: calc(100vw - 2rem);
        max-height: calc(100dvh - 2rem);
        overflow-y: auto;
        box-shadow: var(--soft-shadow);
        animation: modal-enter 240ms cubic-bezier(.16, 1, .3, 1) 1150ms backwards;
    }

    .failure-modal h2 {
        margin-bottom: 1rem;

        color: var(--wrong);
        font-size: clamp(2.5rem, 11vw, 3.5rem);
        line-height: 1;
        text-align: center;

        animation: result-stamp 420ms cubic-bezier(.16, 1, .3, 1) 1270ms backwards;
    }

    .failure-modal p {
        text-align: center;
    }

    .buttons {
        display: flex;
        gap: 1rem;
        justify-content: end;
        margin-top: 1rem;
    }
</style>

@code {
    [Parameter] public GameState GameState { get; set; } = null!;

    [Parameter] public GameMode GameMode { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private int? DayNumber => GameState.Game.PuzzleId;
    private const SessionCategory GameModeSessionCategory = SessionCategory.CanonicalPuzzle;

    private async Task Share()
    {
        ArgumentNullException.ThrowIfNull(DayNumber);

        var text = ShareTextBuilder.BuildDailyChallenge(
            DayNumber.Value);

        await ShareService.ShareAsync(text);
    }

    private ElementReference modal;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The guess input that had focus is disabled once the game ends, so keyboard users start here.
        if (firstRender)
        {
            await modal.FocusAsync();
        }
    }

    private async Task FocusModalAsync() => await modal.FocusAsync();

    private async Task CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private string BuildShareText()
    {
        ArgumentNullException.ThrowIfNull(DayNumber);

        return ShareTextBuilder.BuildDailyChallenge(DayNumber.Value);
    }

    private async Task CopyShareText()
    {
        await ShareService.ShareAsync(BuildShareText());
    }

    private string BuildXLink()
    {
        return $"https://twitter.com/intent/tweet?text={Uri.EscapeDataString(BuildShareText())}";
    }

    private string BuildTelegramLink()
    {
        return $"https://t.me/share/url?text={Uri.EscapeDataString(BuildShareText())}";
    }

    private string BuildRedditLink()
    {
        return $"https://reddit.com/submit?title={Uri.EscapeDataString(BuildShareText())}";
    }
}
