@using MudBlazor
@inject IGameplayAvailabilityService Availability

<MudDialog Class="pop-up pt-0">
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100">
            <h2 class="mb-0">How to Play</h2>

            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" Size="Size.Medium" aria-label="Close"/>
        </div>
    </TitleContent>
    <DialogContent>
        <p>
            You see two characters and one of their numbers. Is the other character's number
            <strong>higher</strong>, <strong>lower</strong>, or <strong>equal</strong>?
            For the day they arrived, the answers are later, earlier, or same day.
        </p>

        <p>Characters are compared by:</p>
        <ul>
            <li>Day arrived</li>
            @if (HasQPhones)
            {
                <li>QPhone number</li>
            }
            <li>YouTube subscribers</li>
            <li>Twitch followers</li>
            <li>Kick followers</li>
        </ul>

        <p>Only characters with a number to compare come up. Subscriber and follower counts aren't live.</p>

        <p>
            Every right answer scores a point, and the second character becomes the first in the next round. One
            mistake, or leaving the page, ends the run.
            Your best score is kept, and shown on your Profile.
        </p>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private bool HasQPhones => Availability.GetActiveClues(Availability.GetEffectiveDate(null)).Contains(ClueGroup.QPhone);

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

}
