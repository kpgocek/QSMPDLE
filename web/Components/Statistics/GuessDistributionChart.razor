@using MudBlazor
@using QSMPDLE.Web.Themes
<div class="mb-4">
    <MudText Typo="Typo.h6" HtmlTag="h4" Class="mb-4 d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-1"/>@Title
    </MudText>

    @if (Distribution == null || Distribution.All(x => x == 0))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No data available</MudText>
    }
    else
    {
        <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" ChartLabels="@GuessLabels" ChartOptions="@Options"
                  Width="100%" Height="300px" @bind-SelectedIndex="@Index" MatchBoundsToSize="true">
        </MudChart>
    }
</div>

@code {

    [Parameter] public double[] Distribution { get; set; } = Array.Empty<double>();

    [Parameter] public string Title { get; set; } = "Guess Distribution";

    private int Index = -1;
    private readonly BarChartOptions Options = new();

    private readonly string[] GuessLabels = [.. Enumerable.Range(1, GameRules.MaxGuesses).Select(count => count.ToString())];

    private List<ChartSeries<double>> Series = [];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        Series = [new ChartSeries<double> { Name = "Wins", Data = Distribution }];

        Options.ChartPalette = QsmpdleTheme.ChartPalette;
    }

}
