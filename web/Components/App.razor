<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <title>QSMPDLE</title>
    <meta property="og:title" content="QSMPDLE" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://qsmpdle.com" />
    <meta property="og:image" content="https://qsmpdle.com/graphics/og-image.png" />
    <meta property="og:description" content="Guess the QSMP2 character of the day." />

    @* Runs before anything paints, so the player's settings (PlayerPreferences, saved in Profile) are in place
       on the first frame. "reduced" covers both the Reduced setting and Follow system on a system that asks for it. *@
    <script>
        (() => {
            const systemReduced = matchMedia("(prefers-reduced-motion: reduce)");
            let preferences = {};

            // MudBlazor wants r, g, b numbers for some tints, which CSS can't take out of a colour.
            // Before the stylesheets load there is nothing to read, so the call after them fills these in.
            const setRgb = (target, source) => {
                const probe = document.createElement("i");
                probe.style.color = `var(${source})`;
                document.head.append(probe);
                const channels = getComputedStyle(probe).color.match(/^rgba?\(([\d.]+), ([\d.]+), ([\d.]+)/);
                probe.remove();
                if (channels && getComputedStyle(document.documentElement).getPropertyValue(source))
                    document.documentElement.style.setProperty(target, channels.slice(1).join(", "));
            };

            window.applyPreferences = value => {
                preferences = value ?? {};
                const motion = String(preferences.motion ?? "").toLowerCase();
                const reduced = motion === "reduced" || (motion !== "full" && systemReduced.matches);
                document.documentElement.dataset.motion = reduced ? "reduced" : "full";
                document.documentElement.dataset.theme = preferences.theme || "navy";
                setRgb("--mud-palette-primary-rgb", "--primary");
                setRgb("--mud-palette-info-rgb", "--primary");
                setRgb("--mud-palette-secondary-rgb", "--secondary");
                setRgb("--mud-palette-success-rgb", "--correct");
                setRgb("--mud-palette-warning-rgb", "--partial");
                setRgb("--mud-palette-error-rgb", "--wrong");
                setRgb("--mud-palette-text-primary-rgb", "--text");
            };
            window.reapplyPreferences = () => applyPreferences(preferences);

            systemReduced.addEventListener("change", reapplyPreferences);
            try {
                applyPreferences(JSON.parse(localStorage.getItem("qsmpdle-preferences")));
            } catch {
                applyPreferences(null);
            }
        })();
    </script>

    <ResourcePreloader />

    <link rel="preload" href="fonts/minecrafter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/Nunito_Sans/NunitoSans-Latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/Bungee/Bungee-Latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap-reboot.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap-utilities.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/themes.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["QSMPDLE.Web.styles.css"]" />
    @* Waits for the stylesheets above, so the theme's colours can be read. *@
    <script>reapplyPreferences();</script>

    <ImportMap />

    <link rel="icon" type="image/png" href="favicon.png" />

    <HeadOutlet @rendermode="InteractiveServer" />

</head>

<body>
    <Routes />
    <ReconnectModal />

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @* Enhanced navigation can rewrite the html element's attributes from the server's copy. *@
    <script>Blazor.addEventListener("enhancedload", reapplyPreferences);</script>

    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/share.js"]"></script>
    <script src="@Assets["js/storage.js"]"></script>
</body>

</html>
