@rendermode InteractiveServer
@implements IDisposable
@using MudBlazor
@using Microsoft.AspNetCore.Components.Routing
@using QSMPDLE.Web.Components.UX.Dialogs
@inject NavigationManager Nav
@inject QSMPDLE.Web.Features.Gameplay.Services.IDayService DayService

<header class="topbar">
    <div class="topbar-container" id="game-top">

        <h1 class="logo">QSMP<span class="text-accent">DLE</span></h1>

        <div class="mobile-menu">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Size="Size.Large"
                           OnClick="@ToggleMenu" aria-label="Toggle Menu"
                           aria-expanded="@(isMenuOpen ? "true" : "false")" aria-controls="site-nav" />
        </div>

        <nav id="site-nav" class="links @MenuVisibilityClass" aria-label="Main">
            <div class="links-row">
                <a href="/" class="@(IsClassic ? "active" : null)" aria-current="@(IsClassic ? "true" : null)">Classic</a>

                <span class="separator">•</span>

                <NavLink href="/profile">
                    Profile
                </NavLink>
            </div>

            @if (IsProfile)
            {
                <div class="links-row links-section">
                    <NavLink href="/profile" Match="NavLinkMatch.All">
                        Player
                    </NavLink>

                    <span class="separator">•</span>

                    <NavLink href="/profile/stats">
                        Stats
                    </NavLink>

                    <span class="separator">•</span>

                    <NavLink href="/profile/settings">
                        Settings
                    </NavLink>
                </div>
            }
            else
            {
                <div class="links-row links-section">
                    <NavLink href="/" Match="NavLinkMatch.All">
                        Daily
                    </NavLink>

                    <span class="separator">•</span>

                    <NavLink href="@ArchiveLink">
                        Archive
                    </NavLink>

                    <span class="separator">•</span>

                    <NavLink href="/practice">
                        Practice
                    </NavLink>

                    <span class="separator">•</span>

                    <NavLink href="/how-to-play">
                        How to Play
                    </NavLink>
                </div>
            }

        </nav>

    </div>
</header>

@code {
    private string ArchiveLink => DayService.GetYesterdayArchiveLink();

    private bool IsProfile => IsAt("/profile") || new Uri(Nav.Uri).AbsolutePath.StartsWith("/profile/", StringComparison.OrdinalIgnoreCase);

    // Every other page, such as the changelog, shows the Classic links.
    private bool IsClassic => !IsProfile;

    private bool IsAt(string path) => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').Equals(path, StringComparison.OrdinalIgnoreCase);

    private bool isMenuOpen = false;

    private string MenuVisibilityClass => isMenuOpen ? "show" : "hide";

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    // The menu outlives enhanced navigation, so it must redraw when the section changes.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }
}
