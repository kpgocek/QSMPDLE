@page "/"
@using MudBlazor
@using QSMPDLE.Web.Components.Game
@rendermode InteractiveServer

<PageTitle>Daily Game - QSMPDLE</PageTitle>

@if (!isGameLoaded)
{
    <h2>
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="min(25rem, calc(100vw - 2rem))" Height="2.375rem"/>
    </h2>
}
else
{
    <h2>DAILY CHARACTER<span class="separator">|</span>#@dailyNumber.ToString("00")</h2>
}

<Gameplay EntryPoint="EntryPoint.Daily" GameStateChanged="OnGameStateChange" GameLoaded="OnGameLoaded"/>

@code {
    private int dailyNumber;
    private bool isGameLoaded;

    private async Task OnGameStateChange(GameState gameState)
    {
        dailyNumber = gameState.Game.PuzzleId ?? 0;
    }

    private async Task OnGameLoaded()
    {
        isGameLoaded = true;
    }

}

