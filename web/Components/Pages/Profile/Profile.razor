@page "/profile"
@using MudBlazor
@using QSMPDLE.Web.Features.Personalization.Models
@using QSMPDLE.Web.Features.Personalization.Services
@using QSMPDLE.Web.Infrastructure.Persistence
@rendermode InteractiveServer

@inject IPreferencesService PreferencesService
@inject ICharacterStore CharacterStore
@inject TimeProvider TimeProvider
@inject ILogger<Profile> Logger

<PageTitle>Profile - QSMPDLE</PageTitle>

<div class="identity">
    @if (avatar is not null)
    {
        <img src="@CharacterUrlHelper.GetHeadSrc(avatar)" alt="" width="64" height="64"/>
    }
    <h2>@(this.preferences?.DisplayName ?? "Profile")</h2>
    @if (this.preferences is not null)
    {
        <MudIconButton Icon="@(editing ? Icons.Material.Filled.Check : Icons.Material.Filled.Edit)"
                       OnClick="@(() => editing = !editing)" Size="Size.Medium"
                       aria-label="@(editing ? "Done editing" : "Edit profile")"
                       aria-expanded="@(editing ? "true" : "false")" aria-controls="profile-details"/>
    }
</div>

@if (editing && this.preferences is { } preferences)
{
    <WebPage>
        <section id="profile-details" aria-label="Edit profile">
            <p class="setting-note">Saved in this browser only.</p>

            @* Saved on Enter or when the field loses focus. *@
            <MudTextField T="string" Label="Name" Value="preferences.DisplayName" ValueChanged="SetNameAsync"
                          MaxLength="PlayerPreferences.MaxNameLength" Variant="Variant.Outlined"
                          HelperText="Used in share text instead of &quot;I&quot;" Class="setting"/>

            <MudAutocomplete T="CharacterLookup" Label="Avatar" Value="avatar" ValueChanged="SetAvatarAsync"
                             SearchFunc="SearchAvatarsAsync" ToStringFunc="@(character => character?.Name)"
                             Clearable="true" MaxItems="null" Variant="Variant.Outlined" Class="setting"
                             Disabled="@(characters.Count == 0)">
                <ItemTemplate Context="character">
                    <span class="avatar-option">
                        <img src="@CharacterUrlHelper.GetHeadSrc(character)" alt="" width="24" height="24"
                             loading="lazy"/>
                        @character.Name
                    </span>
                </ItemTemplate>
            </MudAutocomplete>
        </section>
    </WebPage>
}

@code {
    private PlayerPreferences? preferences;
    private IReadOnlyList<CharacterLookup> characters = [];
    private CharacterLookup? avatar;
    private bool editing;

    // After the first render: preferences live in local storage, which prerendering can't reach.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        preferences = await PreferencesService.GetAsync();
        try
        {
            // Only released characters can be picked, so the avatar never gives one away early.
            characters = await CharacterStore.GetLookupsAvailableOnAsync(DateOnly.FromDateTime(TimeProvider.GetUtcNow().UtcDateTime));
            avatar = characters.FirstOrDefault(character => character.Id == preferences.AvatarCharacterId);
        }
        catch (Exception exception)
        {
            // The name still works without the character list.
            Logger.LogWarning(exception, "Characters failed to load for the avatar picker");
        }

        StateHasChanged();
    }

    private Task SetNameAsync(string? name)
    {
        return SaveAsync(preferences! with { DisplayName = name });
    }

    private async Task SetAvatarAsync(CharacterLookup? character)
    {
        avatar = character;
        await SaveAsync(preferences! with { AvatarCharacterId = character?.Id });
    }

    private Task<IEnumerable<CharacterLookup>> SearchAvatarsAsync(string? text, CancellationToken cancellationToken)
    {
        return Task.FromResult(string.IsNullOrWhiteSpace(text)
            ? characters
            : characters.Where(character => character.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)));
    }

    private async Task SaveAsync(PlayerPreferences preferences)
    {
        this.preferences = preferences;
        try
        {
            this.preferences = await PreferencesService.SaveAsync(preferences);
        }
        catch (Exception exception)
        {
            // Without this the exception tears down the circuit; the setting simply doesn't stick.
            Logger.LogWarning(exception, "Preferences failed to save");
        }
    }

}
