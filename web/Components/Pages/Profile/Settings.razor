@page "/profile/settings"
@rendermode InteractiveServer

@using MudBlazor
@using QSMPDLE.Web.Features.Personalization.Models
@using QSMPDLE.Web.Features.Personalization.Services

@inject IPreferencesService PreferencesService
@inject ILogger<Settings> Logger

<PageTitle>Settings - QSMPDLE</PageTitle>

<WebPage>
    <section aria-labelledby="settings-title">
        <h2 id="settings-title">Settings</h2>

        <p class="setting-note">Saved in this browser only.</p>

        @if (_preferences is { } preferences)
        {
            <h4 id="motion-title">Motion</h4>
            <MudRadioGroup T="MotionPreference" Value="preferences.Motion" ValueChanged="SetMotionAsync"
                           aria-labelledby="motion-title">
                <MudRadio Value="MotionPreference.System" Color="Color.Primary">Follow system</MudRadio>
                <MudRadio Value="MotionPreference.Full" Color="Color.Primary">Full</MudRadio>
                <MudRadio Value="MotionPreference.Reduced" Color="Color.Primary">Reduced</MudRadio>
            </MudRadioGroup>
        }
    </section>
</WebPage>

@code {
    private PlayerPreferences? _preferences;

    // After the first render: preferences live in local storage, which prerendering can't reach.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _preferences = await PreferencesService.GetAsync();
        StateHasChanged();
    }

    private Task SetMotionAsync(MotionPreference motion) => SaveAsync(_preferences! with { Motion = motion });

    private async Task SaveAsync(PlayerPreferences preferences)
    {
        _preferences = preferences;
        try
        {
            _preferences = await PreferencesService.SaveAsync(preferences);
        }
        catch (Exception exception)
        {
            // Without this the exception tears down the circuit; the setting simply doesn't stick.
            Logger.LogWarning(exception, "Preferences failed to save");
        }
    }
}
