@page "/stats"
@rendermode InteractiveServer

@using MudBlazor
@using QSMPDLE.Web.Components.Statistics
@using QSMPDLE.Web.Components.UX.StatDisplay
@using QSMPDLE.Web.Features.Statistics.Models
@using QSMPDLE.Web.Features.Statistics.Services
@using QSMPDLE.Web.Infrastructure.Persistence

@inject IGlobalStatsService GlobalStatsService
@inject ICharacterStore CharacterStore
@inject ILogger<Stats> Logger

<PageTitle>Game Statistics - QSMPDLE</PageTitle>

<WebPage>

    <section class="mb-2">
        <h2>
            Statistics & Telemetry
        </h2>

        <p class="info">
            Some interesting information about our players
        </p>

        <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Outlined" Class="mb-6">
            <strong>Data's incomplete.</strong> We only started collecting gameplay stats from the 1.1 release.
        </MudAlert>

        <MudGrid>
            <MudItem xs="6" sm="3" Style="display:flex;">
                <StatCard Title="Players" Delay="100" Icon="@Icons.Material.Filled.PeopleAlt"
                          Value="@($"{TotalPlayers}")" />
            </MudItem>

            <MudItem xs="6" sm="3" Style="display:flex;">
                <StatCard Title="Recorded Gameplay Sessions" Delay="200" Icon="@Icons.Material.Filled.EmojiEvents"
                          Value="@($"{TotalGamesPlayed}")" />
            </MudItem>

            <MudItem xs="6" sm="3" Style="display:flex;">
                <StatCard Title="Global Win Rate" Delay="300" Icon="@Icons.Material.Filled.LocalFireDepartment"
                          Value="@($"{GlobalWinRate:0}%")" />
            </MudItem>

            <MudItem xs="6" sm="3" Style="display:flex;">
                <StatCard Title="Average Guesses to Win" Delay="400" Icon="@Icons.Material.Filled.Tag"
                          Value="@(GlobalAvgGuessesToWin > 0 ? $"{GlobalAvgGuessesToWin:0.0}" : "-")" />
            </MudItem>
        </MudGrid>

    </section>

    <section class="mb-5">
        <h3>Global Guess Distribution</h3>
        <p class="info mb-4">How many guesses players needed to win</p>

        <div class="mb-4">
            <MudButtonGroup Color="MudBlazor.Color.Primary" Variant="Variant.Outlined">
                <MudButton OnClick="@(() => globalDistributionMode = "Canonical")"
                           Variant="@(globalDistributionMode == "Canonical" ? Variant.Filled : Variant.Outlined)">
                    Puzzle Games
                </MudButton>
                <MudButton OnClick="@(() => globalDistributionMode = "Practice")"
                           Variant="@(globalDistributionMode == "Practice" ? Variant.Filled : Variant.Outlined)">
                    Practice Mode
                </MudButton>
            </MudButtonGroup>
        </div>

        <GuessDistributionChart Distribution="@GlobalGuessDistributionData"
                                Title="@($"Global Guess Distribution ({globalDistributionMode})")" />
    </section>

    <section class="mb-5">
        <h3>Player Activity</h3>

        <div class="mb-4">
            <MudButtonGroup Color="MudBlazor.Color.Primary" Variant="Variant.Outlined">
                <MudButton OnClick="@(() => OnTimeRangeChanged(7))" Disabled="@loadingActivity"
                           Variant="@(selectedDays == 7 ? Variant.Filled : Variant.Outlined)">
                    Last 7 Days
                </MudButton>
                <MudButton OnClick="@(() => OnTimeRangeChanged(30))" Disabled="@loadingActivity"
                           Variant="@(selectedDays == 30 ? Variant.Filled : Variant.Outlined)">
                    Last 30 Days
                </MudButton>
                <MudButton OnClick="@(() => OnTimeRangeChanged(0))" Disabled="@loadingActivity"
                           Variant="@(selectedDays == 0 ? Variant.Filled : Variant.Outlined)">
                    All Time
                </MudButton>
            </MudButtonGroup>
        </div>

        @if (loadingActivity)
        {
            <MudProgressLinear Color="MudBlazor.Color.Primary" Indeterminate="true" Class="mb-4" />
        }
        else
        {
            <DailyActivePlayersChart ChartData="@dauData" />
            <NewVsReturningChart ChartData="@newVsReturningData" />
            <ActivityDistributionChart ChartData="@activityDistribution" />

            <MudGrid Class="mt-4">
                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Average Games Per Player" Delay="500" Icon="@Icons.Material.Filled.Calculate"
                              Value="@(gamesPerPlayer != null ? $"{gamesPerPlayer.Average:0.0}" : "-")" />
                </MudItem>

                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Median Games Per Player" Delay="600" Icon="@Icons.Material.Filled.Functions"
                              Value="@(gamesPerPlayer != null ? $"{gamesPerPlayer.Median:0}" : "-")" />
                </MudItem>

                <MudItem xs="6" sm="4" Style="display:flex;">
                    <StatCard Title="Maximum Games Per Player" Delay="700" Icon="@Icons.Material.Filled.EmojiEvents"
                              Value="@(gamesPerPlayer != null ? $"{gamesPerPlayer.Maximum}" : "-")" />
                </MudItem>
            </MudGrid>
        }
    </section>

    <section class="mb-5">
        <h3>Player Retention</h3>

        @if (loadingRetention)
        {
            <MudProgressLinear Color="MudBlazor.Color.Primary" Indeterminate="true" />
        }
        else
        {
            <table class="retention-table">
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Day</span></th>
                        <th scope="col">Day-N <span class="retention-key">DN</span></th>
                        <th scope="col">Rolling <span class="retention-key">DN+</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (day, exact, rolling) in RetentionRows)
                    {
                        <tr>
                            <th scope="row">Day @day</th>
                            <td>@exact</td>
                            <td>@rolling</td>
                        </tr>
                    }
                </tbody>
            </table>

            <p class="info retention-legend">
                <strong>DN</strong> players who returned on day N after their first game.
                <strong>DN+</strong> players who returned on or after day N.
            </p>
        }
    </section>

    <section class="mb-5">
        <h3>Global Character Insights</h3>
        <p class="info mb-4">Community patterns around characters — top 3 per time window</p>

        @if (loadingGlobalCharacterStats)
        {
            <MudProgressLinear Color="MudBlazor.Color.Primary" Indeterminate="true" Class="mb-4" />
        }
        else if (globalCharacterStats != null)
        {
            <div class="mb-4">
                <MudButtonGroup Color="MudBlazor.Color.Primary" Variant="Variant.Outlined">
                    <MudButton OnClick="@(() => globalCharacterWindow = "AllTime")"
                               Variant="@(globalCharacterWindow == "AllTime" ? Variant.Filled : Variant.Outlined)">
                        All Time
                    </MudButton>
                    <MudButton OnClick="@(() => globalCharacterWindow = "PastMonth")"
                               Variant="@(globalCharacterWindow == "PastMonth" ? Variant.Filled : Variant.Outlined)">
                        Past 30 Days
                    </MudButton>
                    <MudButton OnClick="@(() => globalCharacterWindow = "PastTwoWeeks")"
                               Variant="@(globalCharacterWindow == "PastTwoWeeks" ? Variant.Filled : Variant.Outlined)">
                        Past 14 Days
                    </MudButton>
                </MudButtonGroup>
            </div>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <div class="ranking">
                        <h4 class="ranking-title">🧱 Hardest to Guess</h4>
                        <p class="ranking-note">Required the most guesses on average</p>
                        @RenderCharacterRanking(GetWindowEntries(globalCharacterStats.Hardest))
                    </div>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <div class="ranking">
                        <h4 class="ranking-title">🤔 Most Confusing</h4>
                        <p class="ranking-note">Guessed most often as the wrong answer</p>
                        @RenderCharacterRanking(GetWindowEntries(globalCharacterStats.MostConfusing))
                    </div>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <div class="ranking">
                        <h4 class="ranking-title">💡 The Indicator</h4>
                        <p class="ranking-note">Guess that led to a win on the very next guess</p>
                        @RenderCharacterRanking(GetWindowEntries(globalCharacterStats.TheIndicator))
                    </div>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <div class="ranking">
                        <h4 class="ranking-title">🚀 The Opener</h4>
                        <p class="ranking-note">Most common first guess in winning games</p>
                        @RenderCharacterRanking(GetWindowEntries(globalCharacterStats.TheOpener))
                    </div>
                </MudItem>
            </MudGrid>
        }
    </section>

</WebPage>

@code {
    // Global Stats
    private long TotalPlayers { get; set; }
    private long TotalGamesPlayed { get; set; }
    private long TotalCompletedGames { get; set; }
    private double GlobalWinRate { get; set; }
    private double GlobalCompletionRate { get; set; }
    private double GlobalAvgGuessesToWin { get; set; }
    private double GlobalAvgGuessesPerCompletedGame { get; set; }
    private long[] DailyGuessDistribution { get; set; } = new long[6];
    private long[] PracticeGuessDistribution { get; set; } = new long[6];
    private IReadOnlyList<ModePopularityEntry> modePopularity = [];
    private string globalDistributionMode = "Canonical";

    private double[] GlobalGuessDistributionData
    {
        get
        {
            return globalDistributionMode switch
            {
                "Canonical" => DailyGuessDistribution.Select(x => (double)x).ToArray(),
                "Practice" => PracticeGuessDistribution.Select(x => (double)x).ToArray(),
                _ => new double[6]
            };
        }
    }

    // Player Activity Data
    private List<DailyActivePlayersData>? dauData;
    private List<NewVsReturningPlayersData>? newVsReturningData;
    private PlayerActivityDistributionData[]? activityDistribution;
    private GamesPerPlayerStats? gamesPerPlayer;
    private RetentionStats? retention;

    private IEnumerable<(int Day, string Exact, string Rolling)> RetentionRows =>
    [
        (1, FormatPercent(retention?.D1Retention), FormatPercent(retention?.D1PlusRetention)),
        (7, FormatPercent(retention?.D7Retention), FormatPercent(retention?.D7PlusRetention)),
        (30, FormatPercent(retention?.D30Retention), FormatPercent(retention?.D30PlusRetention)),
    ];

    private static string FormatPercent(double? value) => value is { } percent ? $"{percent:0.0}%" : "-";

    // Character Stats
    private GlobalCharacterStats? globalCharacterStats;
    private string globalCharacterWindow = "AllTime";

    private IReadOnlyList<CharacterStatEntry> GetWindowEntries(CharacterWindowStats stats)
    {
        return globalCharacterWindow switch
        {
            "PastTwoWeeks" => stats.PastTwoWeeks,
            "PastMonth" => stats.PastMonth,
            "AllTime" => stats.AllTime,
            _ => stats.AllTime
        };
    }

    private RenderFragment RenderCharacterRanking(IReadOnlyList<CharacterStatEntry> entries) =>
        @<div>
            @if (!entries.Any())
            {
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">No data available</MudText>
            }
            else
            {
                @for (var i = 0; i < entries.Count && i < 3; i++)
                {
                    var entry = entries[i];
                    var rankBadge = i switch
                    {
                        0 => "🥇",
                        1 => "🥈",
                        2 => "🥉",
                        _ => ""
                    };
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <span style="font-size:1.2rem;">@rankBadge</span>
                        <MudAvatar Style="width:32px;height:32px;" Square="true">
                            <MudImage Src="@($"/graphics/mini-heads/{entry.CharacterName}.webp")" Alt="" />
                        </MudAvatar>
                        <div style="flex:1;">
                            <MudText Typo="Typo.body1">@entry.CharacterName</MudText>
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@entry.Count times</MudText>
                        </div>
                    </div>
                }
            }
        </div>;


    private int selectedDays = 7;
    private bool loadingActivity = true;
    private bool loadingRetention = true;
    private bool loadingGlobalCharacterStats = true;
    private bool initialLoadCompleted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || initialLoadCompleted)
        {
            return;
        }

        try
        {
            await ExecuteWithDiagnosticsAsync(nameof(CollectGlobalDataAsync), CollectGlobalDataAsync);
            await ExecuteWithDiagnosticsAsync(nameof(CollectPlayerActivityDataAsync), CollectPlayerActivityDataAsync);
            await ExecuteWithDiagnosticsAsync(nameof(CollectRetentionDataAsync), CollectRetentionDataAsync);
            await ExecuteWithDiagnosticsAsync(nameof(CollectGlobalCharacterStatsAsync), CollectGlobalCharacterStatsAsync);

            initialLoadCompleted = true;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CollectGlobalDataAsync()
    {
        var globalData = await GlobalStatsService.GetGlobalStatsAsync();

        TotalPlayers = globalData.TotalPlayers;
        TotalGamesPlayed = globalData.TotalGames;
        GlobalWinRate = globalData.WinRate;
        TotalCompletedGames = globalData.TotalCompletedGames;
        GlobalCompletionRate = globalData.CompletionRate;
        GlobalAvgGuessesToWin = globalData.AverageGuessesToWin;
        GlobalAvgGuessesPerCompletedGame = globalData.AverageGuessesPerCompletedGame;
        DailyGuessDistribution = globalData.DailyGuessDistribution;
        PracticeGuessDistribution = globalData.PracticeGuessDistribution;
        modePopularity = globalData.ModePopularity;
    }

    private async Task CollectPlayerActivityDataAsync()
    {
        loadingActivity = true;

        try
        {
            await LoadRangeDependentActivityDataAsync(selectedDays);
            activityDistribution = await GlobalStatsService.GetPlayerActivityDistributionAsync();
            gamesPerPlayer = await GlobalStatsService.GetGamesPerPlayerStatsAsync();
        }
        finally
        {
            loadingActivity = false;
        }
    }

    private async Task CollectRetentionDataAsync()
    {
        loadingRetention = true;

        try
        {
            retention = await GlobalStatsService.GetRetentionStatsAsync();
        }
        finally
        {
            loadingRetention = false;
        }
    }

    private async Task CollectGlobalCharacterStatsAsync()
    {
        loadingGlobalCharacterStats = true;

        try
        {
            var raw = await GlobalStatsService.GetGlobalCharacterStatsAsync();
            var lookups = await CharacterStore.GetLookupsAsync();

            IReadOnlyList<CharacterStatEntry> Resolve(IReadOnlyList<CharacterStatEntry> entries) =>
                entries.Select(e => e with
                {
                    CharacterName = lookups.FirstOrDefault(l => l.Id == e.CharacterId)?.Name ?? e.CharacterId.ToString()
                }).ToList();

            globalCharacterStats = new GlobalCharacterStats
            {
                MostConfusing = new CharacterWindowStats
                {
                    PastTwoWeeks = Resolve(raw.MostConfusing.PastTwoWeeks),
                    PastMonth = Resolve(raw.MostConfusing.PastMonth),
                    AllTime = Resolve(raw.MostConfusing.AllTime),
                },
                MostWonTargets = new CharacterWindowStats
                {
                    PastTwoWeeks = Resolve(raw.MostWonTargets.PastTwoWeeks),
                    PastMonth = Resolve(raw.MostWonTargets.PastMonth),
                    AllTime = Resolve(raw.MostWonTargets.AllTime),
                },
                Hardest = new CharacterWindowStats
                {
                    PastTwoWeeks = Resolve(raw.Hardest.PastTwoWeeks),
                    PastMonth = Resolve(raw.Hardest.PastMonth),
                    AllTime = Resolve(raw.Hardest.AllTime),
                },
                TheIndicator = new CharacterWindowStats
                {
                    PastTwoWeeks = Resolve(raw.TheIndicator.PastTwoWeeks),
                    PastMonth = Resolve(raw.TheIndicator.PastMonth),
                    AllTime = Resolve(raw.TheIndicator.AllTime),
                },
                TheOpener = new CharacterWindowStats
                {
                    PastTwoWeeks = Resolve(raw.TheOpener.PastTwoWeeks),
                    PastMonth = Resolve(raw.TheOpener.PastMonth),
                    AllTime = Resolve(raw.TheOpener.AllTime),
                },
            };
        }
        finally
        {
            loadingGlobalCharacterStats = false;
        }
    }

    private async Task OnTimeRangeChanged(int days)
    {
        if (loadingActivity)
        {
            return;
        }

        await ExecuteWithDiagnosticsAsync($"{nameof(OnTimeRangeChanged)}:{days}", async () =>
        {
            loadingActivity = true;
            selectedDays = days;
            await InvokeAsync(StateHasChanged);

            try
            {
                await LoadRangeDependentActivityDataAsync(days);
            }
            finally
            {
                loadingActivity = false;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private async Task LoadRangeDependentActivityDataAsync(int days)
    {
        var from = CalculateFromDate(days);

        dauData = await GlobalStatsService.GetDailyActivePlayersAsync(from);
        newVsReturningData = await GlobalStatsService.GetNewVsReturningPlayersAsync(from);
    }

    private async Task ExecuteWithDiagnosticsAsync(string operationName, Func<Task> operation)
    {
        Logger.LogDebug("Stats load {Operation} START", operationName);

        try
        {
            await operation();
            Logger.LogDebug("Stats load {Operation} SUCCESS", operationName);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Stats load {Operation} FAILED", operationName);
            throw;
        }
        finally
        {
            Logger.LogDebug("Stats load {Operation} END", operationName);
        }
    }

    private static DateOnly? CalculateFromDate(int days)
    {
        if (days == 0) return null;

        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        return days == 7 ? today.AddDays(-6) : today.AddDays(-29);
    }
}
