@page "/how-to-play"
@using MudBlazor
@using QSMPDLE.Web.Components.Game.Modules
@using QSMPDLE.Web.Infrastructure.Persistence

@inject IGameplayAvailabilityService Availability
@inject ICharacterStore CharacterStore

<PageTitle>Instructions - QSMPDLE</PageTitle>

<WebPage>

    <h2>How to Play</h2>

    <p class="info">
        Last updated: June 2026
    </p>

    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-6">
        <strong>TL;DR:</strong> Guess today's QSMP2 character in 6 attempts.
    </MudAlert>

    <section class="mb-5">
        <h3>Make a Guess</h3>

        <p>
            Start typing a character name and select one from the list.
        </p>

        <p>
            After every guess, each attribute is compared with the hidden character.
        </p>
    </section>

    <section class="mb-5">
        <div class="example-wrapper">
            @if (ExampleGuess is not null)
            {
                <GuessBoard Guesses="@([ExampleGuess])" ActiveClues="@ActiveClues" ShowPlaceholders="false"/>
            }
        </div>

        <div>
            <p>
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Class="color">
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" aria-hidden="true"/>
                    <span class="visually-hidden">Tick</span>
                </MudChip>
                means an exact match.
            </p>
            <p>
                <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" Class="color">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-hidden="true"/>
                    <span class="visually-hidden">Cross</span>
                </MudChip>
                means the attribute does not match at all.
            </p>
            <p>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="color">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" aria-hidden="true"/>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" aria-hidden="true"/>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" aria-hidden="true"/>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" aria-hidden="true"/>
                    <span class="visually-hidden">Arrows</span>
                </MudChip>
                means the answer is higher, lower, later or earlier than provided.
            </p>
            <p>
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Class="color">
                    <MudIcon Icon="@Icons.Material.Filled.Contrast" Size="Size.Small" aria-hidden="true"/>
                    <span class="visually-hidden">Half circle</span>
                </MudChip>
                means the attribute is partially correct (have at least one element of the answer).
            </p>
        </div>

    </section>

    <section class="mb-5">
        <h3>Portrait Hints</h3>

        <p>
            The portrait starts heavily blurred and becomes clearer with every guess.
            Even incorrect guesses reveal more of the image.
        </p>

    </section>

    <section class="mb-5">
        <h3>Game Modes</h3>

        <p>
            <strong>DAILY</strong> — everyone receives the same character each day.
        </p>

        <p>
            <strong>PRACTICE</strong> — play unlimited random rounds without
            affecting your daily streak.
        </p>
    </section>
</WebPage>

@code {
    private const string ExampleCharacter = "FitMC";

    // The page explains today's board, so it only describes clues released by today.
    private IReadOnlySet<ClueGroup> ActiveClues => Availability.GetActiveClues(Availability.GetEffectiveDate(null));

    private GuessResult? ExampleGuess;

    protected override async Task OnInitializedAsync()
    {
        // One colour of each kind; the values come from the real character, so the example cannot drift from the board.
        var lookup = (await CharacterStore.GetLookupsAsync()).FirstOrDefault(character => character.Name == ExampleCharacter);
        if (lookup is null)
            return;

        ExampleGuess = new GuessResult
        {
            Character = lookup,
            Pronouns = ComparisonResult.Wrong,
            Species = ComparisonResult.Correct,
            Languages = ComparisonResult.Less,
            Joined = ComparisonResult.Later,
            Affiliation = ComparisonResult.Partial,
            QPhone = ActiveClues.Contains(ClueGroup.QPhone) ? ComparisonResult.Wrong : null,
            Award2026 = ActiveClues.Contains(ClueGroup.Award2026) ? ComparisonResult.Correct : null
        };
    }

}
