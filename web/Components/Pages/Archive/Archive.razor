@page "/archive"

@using MudBlazor
@using QSMPDLE.Web.Features.Gameplay.Services
@using QSMPDLE.Web.Services

@inject IGameService GameService
@inject IArchiveStatusService ArchiveStatusService

<PageTitle>Archive - QSMPDLE</PageTitle>

<HeadContent>
    <meta name="description" content="Browse and play all past QSMPDLE daily puzzles. Challenge yourself with archived character guessing games from previous days." />
</HeadContent>

<WebPage>
    <h2>Archive</h2>

    <p class="info">
        Play any past daily puzzle. Each day features a different QSMP2 character to guess.
    </p>

    <section class="mb-5">

    @if (!_isLoaded)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_archiveDays.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No archive puzzles available yet. Check back after the first daily puzzle has passed!</MudAlert>
    }
    else
    {
            <MudGrid Spacing="8" Class="archive-grid">

            @foreach (var day in _archiveDays)
            {
                <MudItem xs="3" sm="3" Class="archive-grid-item">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/archive/day/{day.DayNumber}")" Class="@($"card-container {GetStatusClass(GetDayStatus(day.Date.DayNumber))}")">
                            <div class="archive-card">
                                <h3 class="day-number">@day.DayNumber.ToString("00")</h3>
                                <p class="day-date">@day.Date.ToString("MMM d, yyyy")</p>
                            </div>
                        </MudButton>
                </MudItem>
            }

        </MudGrid>
    }

    </section>

</WebPage>

<style>
    .archive-grid {
        gap: 0.5rem;
    }

    .archive-grid-item {
        display: flex;
    }

    .card-container {
        display: flex;
        flex: 1;
        background: var(--surface);

        text-align: center;
        border: 0.125rem solid var(--surface-strong);
        border-radius: 0;
        box-shadow: 0 .25rem .75rem var(--black);
        padding: .75rem .25rem;
    }

    .card-container.archive-notstarted {
        border-color: var(--tint);
    }

    .archive-inprogress {
        border: 1px solid var(--partial);
        background: var(--shadow);
    }

    .archive-inprogress h3 {
        color: var(--partial);
    }

    .archive-won {
        border: 1px solid var(--correct);
        background: var(--shadow);
    }

    .archive-won h3 {
        color: var(--correct);
    }

    .archive-lost {
        border: 1px solid var(--wrong);
        background: var(--black);
    }

    .archive-lost h3 {
        color: var(--wrong);
    }

    .archive-card {
        display: flex;
        flex-direction: column;
    }

    .day-number {
        color: var(--primary);
        font-size: 3rem;
    }

    .day-date {
        color: var(--ghost);
    }
</style>

@code {
    private bool _isLoaded = false;
    private bool _loadRequested;
    private List<ArchiveDayInfo> _archiveDays = new();
    private Dictionary<int, DayStatus> _dayStatuses = new();

    protected override async Task OnInitializedAsync()
    {
        _loadRequested = true;
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loadRequested)
            return;

        _loadRequested = false;

        var firstDay = GameService.GetFirstDay();
        var maxDay = await GameService.GetMaxArchiveDayAsync(CancellationToken.None);
        _dayStatuses = await ArchiveStatusService.GetStatusesAsync(firstDay, firstDay.AddDays(maxDay - 1), true, CancellationToken.None);

        // Generate list of all archive days in reverse order (most recent first)
        _archiveDays = Enumerable.Range(1, maxDay)
            .Select(day => new ArchiveDayInfo
            {
                DayNumber = day,
                Date = firstDay.AddDays(day - 1),
                Status = _dayStatuses.TryGetValue(day, out var status) ? status : DayStatus.NotStarted
            })
            .OrderByDescending(d => d.DayNumber)
            .ToList();

        _isLoaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private DayStatus GetDayStatus(int dayNumber)
        => _dayStatuses.TryGetValue(dayNumber, out var status) ? status : DayStatus.NotStarted;

    private class ArchiveDayInfo
    {
        public int DayNumber { get; set; }
        public DateOnly Date { get; set; }
        public DayStatus Status { get; set; }
    }

    private static string GetStatusClass(DayStatus status) => status switch
    {
        DayStatus.Won => "archive-won",
        DayStatus.Lost => "archive-lost",
        DayStatus.InProgress => "archive-inprogress",
        _ => "archive-notstarted"
    };
}

