@page "/archive/day/{DayNumber:int}"
@using MudBlazor
@using QSMPDLE.Web.Components.Game
@using QSMPDLE.Web.Components.Layout
@using QSMPDLE.Web.Components.UX.Navigation
@using QSMPDLE.Web.Features.Gameplay.Models
@using QSMPDLE.Web.Features.Gameplay.Services
@using QSMPDLE.Web.Features.Statistics.Services

@inject IGameService GameService
@inject IStatisticsService StatisticsService
@inject NavigationManager NavigationManager

<HeadContent>
        <title>Archive Day #@DayNumber.ToString("00") - @ArchiveDate.ToString("MMM d, yyyy") | QSMPDLE</title>
    <meta name="description"
              content="Play the QSMPDLE Archive puzzle from Day #@DayNumber (@ArchiveDate.ToString("MMMM d, yyyy")). Guess the QSMP2 character from the past daily challenge." />

    <link rel="canonical" href="@CanonicalUrl" />

    <meta property="og:title"
          content="Archive Day #@DayNumber.ToString("00") - @ArchiveDate.ToString("MMM d, yyyy") | QSMPDLE" />
    <meta property="og:description"
          content="Play the QSMPDLE Archive puzzle from Day #@DayNumber (@ArchiveDate.ToString("MMMM d, yyyy"))." />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:type" content="website" />
</HeadContent>

@if (!_isValidDay)
{
    <WebPage>
        <h2>Archive Day Not Found</h2>
        <p>Archive day #@DayNumber is not available. Please choose a valid archive day.</p>
        <MudButton Href="/archive/day/1" Variant="Variant.Filled" Color="Color.Primary">
            Return to Day 1
        </MudButton>
    </WebPage>
}
else
{
    @if (!_isGameLoaded)
    {
        <h2>
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="22rem" Height="2.375rem" />
        </h2>

        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="8rem" Height="2rem" />
    }
    else
    {
        <div class="archive-header">
            <button @onclick="NavigateToPrevious" class="@(DayNumber > 1 ? "" : "hidden")" aria-label="Previous day">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Medium" />
            </button>

            <h2 class="header-text">ARCHIVE<span class="separator">|</span>DAY #@DayNumber.ToString("00")</h2>

            <button @onclick="NavigateToNext" aria-label="Next day" class="@(DayNumber < _maxDay ? "" : "hidden")">
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Medium" />
            </button>
        </div>

        <MudButton Class="archive-info" Color="Color.Primary" OnClick="ToggleCalendar">
            <MudText Typo="Typo.body2" Class="archive-date">@ArchiveDate.ToLongDateString()</MudText>
        </MudButton>

        <div class="@(_showCalendar ? "" : "collapsed") mt-3">
            <ArchiveNavigator CurrentDay="@DayNumber" MaxDay="@_maxDay" FirstDay="@_firstDay" DateSelected="ToggleCalendar" CompletedDays="@_completedDays" />
        </div>
    }

    <Gameplay @key="DayNumber" GameMode="GameMode.Archive" ArchiveGameNumber="DayNumber"
              GameStateChanged="OnGameStateChange" GameLoaded="OnGameLoaded" />
}

<style>
    .hidden {
        visibility: hidden;
    }

    .collapsed {
        visibility: collapse;
    }

    .archive-header {
        margin-top: 2.75rem;
        height: 2.5em;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .header-text {
        height: 1em;
        display: flex;
        justify-content: center;
        margin-inline: 1rem;
        min-width: 22rem;
    }

    .separator {
        color: var(--tint);
    }

    .archive-date {
        color: var(--ghost);
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .archive-completed-state {
        margin-top: 2.75rem;
    }
</style>

@code {
    [Parameter]
    public int DayNumber { get; set; }

    private bool _isValidDay = true;
    private bool _isArchiveCompletedDaily = false;
    private bool _isGameLoaded = false;
    private bool _showCalendar = false;
    private int _maxDay;
    private DateOnly _firstDay;
    private HashSet<int>? _completedDays;

    private DateOnly ArchiveDate => _firstDay.AddDays(DayNumber - 1);

    private string CanonicalUrl => $"{NavigationManager.BaseUri.TrimEnd('/')}/archive/day/{DayNumber}";

    protected override async Task OnParametersSetAsync()
    {
        _firstDay = GameService.GetFirstDay();
        _maxDay = await GameService.GetMaxArchiveDayAsync(CancellationToken.None);

        // Validate day number is within valid range.
        _isValidDay = DayNumber >= 1 && DayNumber <= _maxDay;

        _isGameLoaded = false;
        _showCalendar = false;
        _isArchiveCompletedDaily = false;
        _completedDays = null;

        if (!_isValidDay)
            return;

        await LoadArchiveStateAsync();
    }

    private async Task LoadArchiveStateAsync()
    {
        try
        {
            var playerId = await GetPlayerIdAsync();
            _isArchiveCompletedDaily = (await StatisticsService.GetPlayerCompletedDailyGameAsync(playerId, DayNumber)) is not null;

            // Load the set of completed daily numbers for the current player in one query.
            var completed = await StatisticsService.GetPlayerCompletedDailyNumbersAsync(playerId);
            _completedDays = completed is null ? null : new HashSet<int>(completed);

            _isGameLoaded = true;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<Guid> GetPlayerIdAsync()
    {
        var playerStats = await StatisticsService.GetPlayerStatsAsync();
        return playerStats.Id;
    }

    private Task OnGameStateChange(GameState gameState)
    {
        return Task.CompletedTask;
    }

    private async Task OnGameLoaded()
    {
        _isGameLoaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private void NavigateToPrevious()
    {
        if (DayNumber > 1)
        {
            NavigationManager.NavigateTo($"/archive/day/{DayNumber - 1}");
        }
    }

    private void NavigateToNext()
    {
        if (DayNumber < _maxDay)
        {
            NavigationManager.NavigateTo($"/archive/day/{DayNumber + 1}");
        }
    }

    private void ToggleCalendar()
    {
        _showCalendar = !_showCalendar;
    }
}
