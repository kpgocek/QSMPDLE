@page "/archive/day/{DayNumber:int}"
@rendermode InteractiveServer

@using MudBlazor
@using QSMPDLE.Web.Components.Game
@using QSMPDLE.Web.Components.Layout
@using QSMPDLE.Web.Components.UX.Navigation
@using QSMPDLE.Web.Features.Gameplay.Models
@using QSMPDLE.Web.Features.Gameplay.Services

@inject IDayService DayService
@inject NavigationManager NavigationManager

<PageTitle>Archive Day #@DayNumber.ToString("00") - @ArchiveDate.ToString("MMM d, yyyy") | QSMPDLE</PageTitle>

<HeadContent>
    <meta name="description"
          content="Play the QSMPDLE Archive puzzle from Day #@DayNumber (@ArchiveDate.ToString("MMMM d, yyyy")). Guess the QSMP2 character from the past daily challenge." />

    <link rel="canonical" href="@CanonicalUrl" />

    <meta property="og:title"
          content="Archive Day #@DayNumber.ToString("00") - @ArchiveDate.ToString("MMM d, yyyy") | QSMPDLE" />
    <meta property="og:description"
          content="Play the QSMPDLE Archive puzzle from Day #@DayNumber (@ArchiveDate.ToString("MMMM d, yyyy"))." />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:type" content="website" />
</HeadContent>

@if (!_isValidDay)
{
    <WebPage>
        <h2>Archive Day Not Found</h2>
        <p>Archive day #@DayNumber is not available. Please choose a valid archive day.</p>
        <MudButton Href="/archive/day/1" Variant="Variant.Filled" Color="Color.Primary">
            Return to Day 1
        </MudButton>
    </WebPage>
}
else
{
    @if (!_isGameLoaded)
    {
        <h2>
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="22rem" Height="2.375rem" />
        </h2>

        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="8rem" Height="2rem" />
    }
    else
    {
        <div class="archive-header">
            <button @onclick="NavigateToPrevious" class="@(DayNumber > 1 ? "" : "hidden")" aria-label="Previous day">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Medium" />
            </button>

            <h2 class="header-text">ARCHIVE<span class="separator">|</span>DAY #@DayNumber.ToString("00")</h2>

            <button @onclick="NavigateToNext" aria-label="Next day" class="@(DayNumber < _maxDay ? "" : "hidden")">
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Medium" />
            </button>
        </div>

        <MudButton Class="archive-info" Color="Color.Primary" OnClick="ToggleCalendar">
            <MudText Typo="Typo.body2" Class="archive-date">@ArchiveDate.ToLongDateString()</MudText>
        </MudButton>

        <div class="@(_showCalendar ? "" : "collapsed") mt-3">
            <ArchiveNavigator CurrentDay="@DayNumber" MaxDay="@_maxDay" FirstDay="@_firstDay" DateSelected="ToggleCalendar"
                              @ref="_navigator" />
        </div>
    }

    <Gameplay @key="DayNumber" EntryPoint="EntryPoint.Archive" ArchiveGameNumber="DayNumber"
              GameStateChanged="OnGameStateChange" GameLoaded="OnGameLoaded" />
}

@code {
    [Parameter]
    public int DayNumber { get; set; }

    // Only while prerendering.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool _isValidDay = true;
    private bool _isGameLoaded = false;
    private bool _showCalendar = false;
    private int _maxDay;
    private DateOnly _firstDay;
    private bool _isInitialized;
    private ArchiveNavigator? _navigator;

    // Null until Gameplay reports its loaded state, so the load notification never triggers a status query.
    private int? _lastGuessCount;

    private DateOnly ArchiveDate => DayService.GetArchiveDate(DayNumber);

    private string CanonicalUrl => $"{Site.Url}/archive/day/{DayNumber}";

    protected override async Task OnParametersSetAsync()
    {
        _firstDay = DayService.GetFirstDay();
        _maxDay = DayService.GetMaxArchiveDay();

        // Validate day number is within valid range.
        _isValidDay = DayNumber >= 1 && DayNumber <= _maxDay;
        if (!_isValidDay && HttpContext is { Response.HasStarted: false } context)
        {
            // Set only as the response starts: an earlier 404 makes Blazor drop this page and its message.
            context.Response.OnStarting(() =>
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
                return Task.CompletedTask;
            });
        }

        _isGameLoaded = false;
        _showCalendar = false;
        _isInitialized = false;
        _lastGuessCount = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_isValidDay || _isInitialized)
            return;

        _isInitialized = true;
        _isGameLoaded = true;
        StateHasChanged();
    }

    private async Task OnGameStateChange(GameState gameState)
    {
        var guessCount = gameState.GuessesMade.Count;
        var isNewGuess = guessCount > _lastGuessCount;
        _lastGuessCount = guessCount;

        if (isNewGuess && _navigator is not null)
        {
            await _navigator.RefreshDayAsync(DayNumber);
        }
    }

    private async Task OnGameLoaded()
    {
        _isGameLoaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private void NavigateToPrevious()
    {
        if (DayNumber > 1)
        {
            NavigationManager.NavigateTo($"/archive/day/{DayNumber - 1}");
        }
    }

    private void NavigateToNext()
    {
        if (DayNumber < _maxDay)
        {
            NavigationManager.NavigateTo($"/archive/day/{DayNumber + 1}");
        }
    }

    private void ToggleCalendar()
    {
        _showCalendar = !_showCalendar;
    }
}
