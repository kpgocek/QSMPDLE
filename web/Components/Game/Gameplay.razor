@using MudBlazor
@using QSMPDLE.Web.Components.Game.Modules
@using QSMPDLE.Web.Components.UX.Dialogs
@using QSMPDLE.Web.Components.UX.StatDisplay
@using QSMPDLE.Web.Features.Communication.GameEvents
@using QSMPDLE.Web.Features.Gameplay.Models
@using QSMPDLE.Web.Features.Gameplay.Services

@inject IGameStateManager GameStateManager
@inject ILogger<Gameplay> Logger

<p class="visually-hidden" role="status">@_announcement</p>

<MudStack AlignItems="AlignItems.Center" Spacing="4" Class="w-100 gameplay">
    @if (_loadFailed)
    {
        <div class="game-error" role="alert">
            <p>We couldn't load the game. Check your connection and try again.</p>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RetryLoadAsync">Try again</MudButton>
        </div>
    }
    else if (!IsGameLoaded)
    {

        <MudPaper Style="padding: .5rem; border: 0.125rem solid var(--line-strong); box-shadow: var(--soft-shadow);"
                  Elevation="0" Height="min(20rem, 82vw);" Width="min(20rem, 82vw);">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" Width="100%" />
        </MudPaper>

        @if (GameMode == GameMode.Practice)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="min(16rem, calc(100vw - 2rem))" Height="3rem" />
        }

        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="min(24.25rem, calc(100vw - 2rem))" Height="3rem" />
    }
    else
    {
        <CharacterPortrait PortraitFolder="@(GameStateManager.GameState?.Game.PortraitUrl ?? string.Empty)"
                           GuessesMade="@(GameStateManager.GameState?.GuessesMade.Count ?? 0)"
                           IsGuessed="@(GameStateManager.GameState?.IsWon ?? false)"
                           IsFailed="@(GameStateManager.GameState?.IsLost ?? false)" />

        @if (GameStateManager.GameState?.IsFinished ?? false)
        {
            <div class="answer-reveal @(GameStateManager.GameState.IsWon ? "success" : "failure")">
                <h3>@TargetName</h3>
            </div>
        }
        else
        {
            <CharacterSelector @bind-Value="GuessedCharacter" OnGuessConfirmed="Guess"
                               IsGuessed="@(GameStateManager.GameState?.IsFinished ?? false)" IsBusy="@_isGuessing"
                               GuessedIds="@GuessedIds" />

            @if (_guessFailed)
            {
                <p class="guess-error" role="alert">That guess didn't go through. Refresh the page if your board looks wrong.</p>
            }

            <p class="guess-hint">
                Guess any character; each clue shows how close you are · <a href="how-to-play">How to play</a>
            </p>
        }

        @if (GameMode == GameMode.Practice)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="NewPractice">
                New Character
            </MudButton>
        }

    }

    <div class="guess-table-container">
        <GuessTable Guesses="@(GameStateManager.GameState?.GuessesMade ?? [])" ShowLegend="@GameStateManager.IsFirstGame" />
        <GuessCards Guesses="@(GameStateManager.GameState?.GuessesMade ?? [])" ShowLegend="@GameStateManager.IsFirstGame" />
    </div>

</MudStack>



@* Waits for the guess to finish so the victory dialog loads statistics that include this game. *@
@if (!_isGuessing && !(GameStateManager.GameState?.SeenPopup ?? false) && (GameStateManager.GameState?.IsWon ?? false))
{
    <VictoryDialog GameState="@GameStateManager.GameState" GameMode="GameMode" OnClose="ClosePopups" />
}

@if (!_isGuessing && !(GameStateManager.GameState?.SeenPopup ?? false) && (GameStateManager.GameState?.IsLost ?? false))
{
    <FailureDialog GameState="@GameStateManager.GameState" GameMode="GameMode" OnClose="ClosePopups" />
}


<style>
    .gameplay {
        position: relative;
        margin-top: 1.25rem;
    }

    .gameplay::before {
        content: "";
        position: absolute;
        inset: 0;

        background: radial-gradient(ellipse at center, var(--surface), transparent 70%);

        z-index: -1;
    }

    .guess-table-container {
        width: 100%;
        max-width: 96rem;
    }

    .answer-reveal {
        text-align: center;
    }

    .answer-reveal h3 {
        font-weight: 700;
    }

    .game-error {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        text-align: center;
    }

    .guess-error {
        margin: 0;
        color: var(--white);
        text-align: center;
    }

    .success {
        color: var(--correct);
    }

    .failure {
        color: var(--wrong);
    }
</style>

@code {
    [Parameter]
    public GameMode GameMode { get; set; }

    [Parameter]
    public int? ArchiveGameNumber { get; set; }

    [Parameter]
    public EventCallback<GameState> GameStateChanged { get; set; }

    [Parameter]
    public EventCallback GameLoaded { get; set; }

    [Parameter]
    public EventCallback<GameFinishedEvent> GameFinished { get; set; }

    private CharacterLookup? GuessedCharacter;
    private bool IsGameLoaded = false;
    private bool _isGuessing;
    private bool _loadFailed;
    private bool _guessFailed;
    private string _announcement = string.Empty;
    private string TargetName = string.Empty;
    private const int MaxGuesses = 6;

    private IReadOnlyCollection<int> GuessedIds =>
        GameStateManager.GameState?.GuessesMade.Select(guess => guess.Character.Id).ToHashSet() ?? [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await StartNewGameAsync();
        }
    }

    public async Task Guess(CharacterLookup? _ = null)
    {
        if (_isGuessing || GameStateManager.GameState is null || GameStateManager.GameState.IsFinished || GuessedCharacter is
null)
            return;

        _isGuessing = true;
        _guessFailed = false;
        var guessedCharacterId = GuessedCharacter.Id;
        GuessedCharacter = null;

        try
        {
            var result = await GameStateManager.MakeGuessAsync(guessedCharacterId);

            // A competing canonical session can replace state without accepting this guess.
            if (GameStateManager.GameState.IsFinished)
            {
                TargetName = await GameStateManager.GetTargetName();
            }

            _announcement = result is null ? string.Empty : Describe(result);

            await GameStateChanged.InvokeAsync(GameStateManager.GameState);
            await InvokeAsync(StateHasChanged);

        }
        catch (Exception exception)
        {
            // Without this the exception tears down the circuit and the player loses the page.
            Logger.LogError(exception, "Guess failed in the gameplay component");
            _guessFailed = true;
        }
        finally
        {
            _isGuessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string Describe(GuessResult guess)
    {
        var name = guess.Character.Name;

        if (guess.IsCorrect)
            return $"{name} is correct!";

        var clues = $"Pronouns {GuessChip.Describe(guess.Pronouns)}, species {GuessChip.Describe(guess.Species)}, " +
                    $"languages {GuessChip.Describe(guess.Languages)}, joined {GuessChip.Describe(guess.Joined)}, " +
                    $"QPhone {GuessChip.Describe(guess.QPhone)}, 2026 award {GuessChip.Describe(guess.Award2026)}, " +
                    $"affiliation {GuessChip.Describe(guess.Affiliation)}.";

        var left = MaxGuesses - (GameStateManager.GameState?.GuessesMade.Count ?? 0);
        var outcome = left > 0
            ? $"{left} {(left == 1 ? "guess" : "guesses")} left."
            : $"No guesses left. The answer was {TargetName}.";

        return $"{name}: {clues} {outcome}";
    }

    private async Task RetryLoadAsync()
    {
        _loadFailed = false;
        await StartNewGameAsync();
    }

    private async Task StartNewGameAsync()
    {
        LoadGameResult loadingResult;
        try
        {
            loadingResult = await GameStateManager.StartGameAsync(GameMode, GameMode == GameMode.Archive ? ArchiveGameNumber : null);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Game failed to load");
            loadingResult = LoadGameResult.Failed;
        }

        if (loadingResult == LoadGameResult.Failed)
        {
            _loadFailed = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Notify parent component of the updated game state
        await GameStateChanged.InvokeAsync(GameStateManager.GameState);

        if (GameStateManager.GameState.IsFinished)
        {
            TargetName = await GameStateManager.GetTargetName();
        }

        IsGameLoaded = true;
        await GameLoaded.InvokeAsync();

        await InvokeAsync(StateHasChanged);
    }

    private async Task NewPractice()
    {
        await GameStateManager.StartNewPracticeGameAsync();
        TargetName = string.Empty;
        _announcement = "New character. 6 guesses left.";
        _guessFailed = false;
        await GameStateChanged.InvokeAsync(GameStateManager.GameState);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClosePopups()
    {
        if (GameStateManager.GameState is null)
            return;

        await GameStateManager.MarkPopupAsSeenAsync();

        await InvokeAsync(StateHasChanged);
    }

}
