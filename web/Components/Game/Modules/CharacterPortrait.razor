@using MudBlazor

<MudPaper Class="@(IsGuessed || IsFailed ? "portrait-frame solved" : "portrait-frame")" Elevation="0">
    <img src="@ImageUrl" alt="@AltText" class="portrait-image" width="320" height="320" loading="eager" decoding="async" fetchpriority="high" />
</MudPaper>

    @code {
    [Parameter] public string PortraitFolder { get; set; } = string.Empty;

    [Parameter] public int GuessesMade { get; set; }

    [Parameter] public bool IsGuessed { get; set; }
    [Parameter] public bool IsFailed { get; set; }

    private string AltText => IsGuessed || IsFailed
        ? "Portrait of today's character, revealed"
        : "Blurred portrait of the mystery character. It sharpens with each guess";

    private string ImageUrl => IsGuessed || IsFailed
        ? CharacterUrlHelper.GetPortraitSrc(PortraitFolder)
        : CharacterUrlHelper.GetBlurredPortraitSrc(PortraitFolder, GuessesMade);
}
