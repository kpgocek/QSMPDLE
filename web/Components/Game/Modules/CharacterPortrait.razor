@using MudBlazor

<MudPaper Class="portrait-frame" Elevation="0">
    <img src="@ImageUrl" alt="Character" class="portrait-image" width="320" height="320" loading="eager" decoding="async" fetchpriority="high" />
</MudPaper>

<style>
    .portrait-frame {
        position: relative;
        padding: .5rem;
        width: min(20rem, 82vw);
        aspect-ratio: 1;

        border: 0.125rem solid var(--line-strong);

        box-shadow: var(--soft-shadow);

        border-radius: 0;
        overflow: hidden;
        animation: soft-pulse 4s ease-in-out infinite;
    }

    .portrait-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        image-rendering: pixelated;
        border-radius: 0;
    }

    .portrait-frame::after {
        content: "";

        position: absolute;
        inset: 0;

        backdrop-filter: brightness(1.125);
        background: linear-gradient(to top right, transparent 45%, var(--tint) 120%);
        opacity: 0.28;

    }
</style>

    @code {
    [Parameter] public string PortraitFolder { get; set; } = string.Empty;

    [Parameter] public int GuessesMade { get; set; }

    [Parameter] public bool IsGuessed { get; set; }
    [Parameter] public bool IsFailed { get; set; }

    private string ImageUrl => IsGuessed || IsFailed
        ? CharacterUrlHelper.GetPortraitSrc(PortraitFolder)
        : CharacterUrlHelper.GetBlurredPortraitSrc(PortraitFolder, GuessesMade);
}
