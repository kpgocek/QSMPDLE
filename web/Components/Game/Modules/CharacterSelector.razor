@using QSMPDLE.Web.Infrastructure.Persistence
@inject ICharacterStore CharacterStore

<div class="selection-area">
    <div class="input-field">
        @* readonly, not disabled, while a guess is in flight: disabling blurs the input and closes the phone keyboard. *@
        <input type="text" @bind="SearchText" @bind:event="oninput" @onkeydown="HandleKeyDown"
               placeholder="Type in character's name" disabled="@IsGuessed" readonly="@IsBusy"
               aria-busy="@(IsBusy ? "true" : "false")"
               aria-label="Guess a character" autocomplete="off" spellcheck="false"
               role="combobox" aria-autocomplete="list" aria-controls="character-suggestions"
               aria-expanded="@(HasSuggestions ? "true" : "false")"
               aria-activedescendant="@(HasSuggestions ? $"character-suggestion-{ActiveSuggestionIndex}" : null)"/>
    </div>

    @if (HasSuggestions)
    {
        <div id="character-suggestions" class="suggestions" role="listbox" aria-label="Matching characters">
            @foreach (var item in Suggestions.Select((m, i) => new { Character = m, Index = i }))
            {
                <button type="button" id="character-suggestion-@item.Index" role="option" tabindex="-1"
                        aria-selected="@(item.Index == ActiveSuggestionIndex ? "true" : "false")"
                        class="suggestion @(item.Index == ActiveSuggestionIndex ? "active" : "")"
                        @onclick="() => SelectAndGuess(item.Character)">
                    <img src="@CharacterUrlHelper.GetHeadSrc(item.Character)" alt="" loading="lazy" decoding="async"/>
                    <div class="names">
                        <span>@item.Character.Name</span>
                    </div>
                </button>
            }
        </div>
    }
    else if (ShowsEmptyState)
    {
        <p class="suggestions no-match" role="status">
            @(HasGuessedEveryMatch ? "You've already guessed everyone matching that name" : "No character matches that name")
        </p>
    }
</div>

@code {
    [Parameter] public CharacterLookup? Value { get; set; }

    [Parameter] public EventCallback<CharacterLookup?> ValueChanged { get; set; }

    [Parameter] public EventCallback<CharacterLookup> OnGuessConfirmed { get; set; }

    [Parameter] public bool IsGuessed { get; set; }

    [Parameter] public bool IsBusy { get; set; }

    [Parameter] public IReadOnlyCollection<int> GuessedIds { get; set; } = [];

    /// <summary>The game's date; only characters released by then are offered.</summary>
    [Parameter][EditorRequired]
    public DateOnly AvailableOn { get; set; }

    /// <summary>Always offered: a release date moved past a played day must not make that day unwinnable.</summary>
    [Parameter][EditorRequired]
    public int AnswerId { get; set; }

    private (DateOnly, int)? _loadedFor;

    private string SearchText = "";

    private int ActiveSuggestionIndex;

    private bool IsDismissed;

    private bool IsListOpen => !IsGuessed && !IsBusy && !IsDismissed && !string.IsNullOrWhiteSpace(SearchText);

    private bool HasSuggestions => IsListOpen && Suggestions.Any();

    private bool ShowsEmptyState => IsListOpen && !Suggestions.Any();

    private bool HasGuessedEveryMatch => Matches.Any();

    private IReadOnlyList<CharacterLookup> Characters = [];

    protected override async Task OnParametersSetAsync()
    {
        // A circuit can outlive midnight or switch games, so the list follows the game's date.
        if (_loadedFor == (AvailableOn, AnswerId))
            return;

        _loadedFor = (AvailableOn, AnswerId);
        Characters = await CharacterStore.GetLookupsAvailableOnAsync(AvailableOn);
        if (Characters.All(character => character.Id != AnswerId) && await CharacterStore.GetLookupAsync(AnswerId) is { } answer)
            Characters = [.. Characters, answer];
    }

    private async Task SelectAndGuess(CharacterLookup? character)
    {
        if (character is null || IsBusy)
            return;

        SearchText = "";
        Value = character;

        await ValueChanged.InvokeAsync(character);
        await OnGuessConfirmed.InvokeAsync(character);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // First Escape closes the list and keeps the text; a second one clears it.
        if (e.Key == "Escape")
        {
            if (IsListOpen)
                IsDismissed = true;
            else
                SearchText = "";
            return;
        }

        IsDismissed = false;
        var suggestions = HasSuggestions ? Suggestions.ToList() : [];

        if (suggestions.Count == 0)
            return;

        switch (e.Key)
        {
            case "ArrowDown":
                ActiveSuggestionIndex = Math.Min(ActiveSuggestionIndex + 1, suggestions.Count - 1);
                break;

            case "ArrowUp":
                ActiveSuggestionIndex = Math.Max(ActiveSuggestionIndex - 1, 0);
                break;

            case "Enter":
                await SelectAndGuess(suggestions[ActiveSuggestionIndex]);
                break;

            default:
                ActiveSuggestionIndex = 0;
                break;
        }
    }

    private IEnumerable<CharacterLookup> Matches =>
        string.IsNullOrWhiteSpace(SearchText)
            ? []
            : Characters
                .Where(p =>
                    p.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<CharacterLookup> Suggestions =>
        Matches.Where(p => !GuessedIds.Contains(p.Id)).Take(5);

}
