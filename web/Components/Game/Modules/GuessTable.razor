@using MudBlazor
@using QSMPDLE.Web.Components.UX.StatDisplay
@using QSMPDLE.Web.Features.Gameplay.Models
@using QSMPDLE.Web.Infrastructure.Persistence

@inject ICharacterStore CharacterStore

@if (Guesses is not null)
{
    <table class="guess-table mx-auto">
        <thead>
            <tr>
                <th>Character</th>
                <th>
                    <MudTooltip Text="Including 'Any'">
                        <span class="header-with-icon">Pronouns
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                        </span>
                    </MudTooltip>
                </th>

                <th>
                    <MudTooltip Text="'Human', 'Not Human' or 'Unknown'">
                        <span class="header-with-icon">Species
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                        </span>
                    </MudTooltip>
                </th>
                <th>Languages</th>
                <th>Joined</th>
                <th>
                    <MudTooltip Text="Has a QPhone">
                        <span class="header-with-icon">QPhone
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                        </span>
                    </MudTooltip>
                </th>
                <th>
                    <MudTooltip Text="Won a QSMP Award in 2026">
                        <span class="header-with-icon">Award '26
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                        </span>
                    </MudTooltip>
                </th>
                <th>Affiliations</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var guess in Guesses)
            {
                var character = GetCharacter(guess.Character.Id);

                if (character is null)
                {
                    continue;
                }

                <tr class="answer-row @(guess == Guesses.Last() ? "new-row" : "")">
                    <td>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Square="true" Size="Size.Large">
                                <MudImage Src="@CharacterUrlHelper.GetHeadSrc(character)" Alt="" />
                            </MudAvatar>
                            <span class="guess-name">@character.Name</span>
                        </MudStack>
                    </td>

                    <td>
                        <GuessChip Result="guess.Pronouns">
                            @DisplayList(character.Pronouns)
                        </GuessChip>
                    </td>

                    <td>
                        <GuessChip Result="guess.Species">
                            @FormatSpecies(character)
                        </GuessChip>
                    </td>

                    <td>
                        <GuessChip Result="guess.Languages">
                            @(character.LanguageCount > 3 ? $"4+ ({character.LanguageCount})" : character.LanguageCount)
                        </GuessChip>
                    </td>

                    <td>
                        <GuessChip Result="guess.Joined">
                            Day @character.JoinDayNumber
                        </GuessChip>
                    </td>

                    <td>
                        <GuessChip Result="guess.QPhone">@YesNo(character.HasQPhone)</GuessChip>
                    </td>

                    <td>
                        <GuessChip Result="guess.Award2026">@YesNo(character.WonAward2026)</GuessChip>
                    </td>

                    <td>
                        <div class="chip-flow">
                            @if (character.Affiliations.Count > 0)
                            {
                                @foreach (var affiliation in character.Affiliations)
                                {
                                    <GuessChip Result="guess.Affiliation">@affiliation</GuessChip>
                                }
                            }
                            else
                            {
                                <GuessChip Result="guess.Affiliation">None</GuessChip>
                            }
                        </div>
                    </td>
                </tr>

                if (ShowLegend && guess == Guesses[0])
                {
                    <tr>
                        <td colspan="8">
                            <FirstGuessLegend Guess="guess" />
                        </td>
                    </tr>
                }
            }

            @for (int i = Guesses.Count; i < MaxGuesses; i++) // 1-2-3-4-5-6
            {
                <tr class="empty-row opacity-@(MaxGuesses + Guesses.Count - i)">
                    <td>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Square="true" Class="placeholder-avatar" Size="Size.Large" />

                            <span class="placeholder-name">&nbsp;</span>
                        </MudStack>
                    </td>

                    @for (var clue = 0; clue < ClueCount; clue++)
                    {
                        <td>
                            <MudChip T="string" Class="placeholder-chip">
                                &nbsp;
                            </MudChip>
                        </td>
                    }
                </tr>
            }

        </tbody>
    </table>
}

<style>
    .guess-table {
        width: 100%;
        min-width: 68rem;
        border-collapse: separate;
        border-spacing: 0 .5rem;
    }

    .guess-table tr {
        height: 3rem;
    }

    .guess-table th {
        color: var(--white);
        text-transform: uppercase;
        padding-inline-end: .5rem;

        font-size: .8rem;
        letter-spacing: .05em;
        font-weight: 400;
        white-space: nowrap;
    }

    /* The last header has no neighbour to keep clear of, and its column is the narrowest. */
    .guess-table th:last-child {
        padding-inline-end: 0;
    }

    .guess-table td {
        padding-block: .25rem;
    }

    /* Affiliations, the only column without a width, takes most of the extra room because its content is open-ended;
       Species grows a little with the board (about 11rem at the 68rem minimum) so two-word species fit on wider screens. */
    .guess-table th:nth-child(1) { width: 13rem; }
    .guess-table th:nth-child(2) { width: 8rem; }
    .guess-table th:nth-child(3) { width: 16%; }
    .guess-table th:nth-child(4) { width: 6rem; }
    .guess-table th:nth-child(5) { width: 7rem; }
    .guess-table th:nth-child(6) { width: 6rem; }
    .guess-table th:nth-child(7) { width: 7rem; }

    /* Long values wrap inside their column instead of pushing the row wider. */
    .guess-table .mud-chip {
        height: auto;
        min-height: 2rem;
        max-width: calc(100% - .5rem);
        white-space: normal;
    }

    .guess-table .guess-name {
        line-height: 1.2;
        overflow-wrap: break-word;
    }

    /* Affiliation chips sit side by side and wrap downward only when the column runs out of room. */
    .chip-flow {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
    }

    .guess-table td,
    .guess-table th {
        vertical-align: middle;
    }

    .header-with-icon {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
    }

    .header-with-icon .mud-icon-root {
        position: relative;
        top: -.0625rem;
    }

    .answer-row {
        user-select: none;
        border: 0.125rem solid var(--panel-edge);
        background: linear-gradient(90deg, var(--panel-strong), var(--panel));
        box-shadow: inset 0 0 0 .0625rem var(--black);
        transition:
            border-color 160ms ease,
            background-color 160ms ease;
    }

    /* Tall rows (several affiliations) read along their first line: every clue centres on the 56px portrait
       and extra affiliation chips extend downward. */
    .guess-table .answer-row td {
        vertical-align: top;
    }

    .guess-table .answer-row td + td {
        padding-top: .75rem;
    }

    .answer-row:hover {
        border-color: var(--line-strong);
    }

    .empty-row {
        user-select: none;
        border: 0.125rem solid var(--line);
        background: hsla(var(--primary-hsl), 0.1);
    }

    .placeholder-avatar {
        background: rgba(255, 255, 255, .08);
        border: .0625rem solid rgba(255, 255, 255, .15);
        opacity: .4;
    }

    .placeholder-name {
        width: 7rem;
        background: rgba(255, 255, 255, .08);
    }

    .placeholder-chip {
        width: 6rem;
        height: 2rem;
        margin: 0 auto;

        opacity: .25;
        pointer-events: none;
    }

    .new-row {
        animation: reveal-row 300ms cubic-bezier(.2, .8, .2, 1);
    }

    /* The newest guess turns its clues over one at a time, left to right. */
    .new-row .mud-chip {
        animation: reveal-chip 380ms cubic-bezier(.16, 1, .3, 1) backwards;
    }

    .new-row td:nth-child(2) .mud-chip { animation-delay: 150ms; }
    .new-row td:nth-child(3) .mud-chip { animation-delay: 250ms; }
    .new-row td:nth-child(4) .mud-chip { animation-delay: 350ms; }
    .new-row td:nth-child(5) .mud-chip { animation-delay: 450ms; }
    .new-row td:nth-child(6) .mud-chip { animation-delay: 550ms; }
    .new-row td:nth-child(7) .mud-chip { animation-delay: 650ms; }
    .new-row td:nth-child(8) .mud-chip { animation-delay: 750ms; }
</style>

@code {
    [Parameter]
    public IReadOnlyList<GuessResult> Guesses { get; set; } = null!;

    [Parameter]
    public int MaxGuesses { get; set; } = 6;

    [Parameter]
    public bool ShowLegend { get; set; }

    private const int ClueCount = 7;

    private IReadOnlyDictionary<int, Character> CharactersById { get; set; } = new Dictionary<int, Character>();

    protected override async Task OnInitializedAsync()
    {
        CharactersById = await CharacterStore.GetCharacterMapAsync();
    }

    private static string DisplayList(IEnumerable<string> values)
    {
        return values.Any()
            ? string.Join("/", values)
            : "None";
    }

    private static string YesNo(bool value) => value ? "Yes" : "No";

    private Character? GetCharacter(int id)
    {
        return CharactersById.GetValueOrDefault(id);
    }

    private static string FormatSpecies(Character character) =>
        character.Species.Contains("Human")
            ? DisplayList(character.Species)
            : character.Species.Contains("Unknown")
                ? DisplayList(character.Species)
                : $"Not Human ({DisplayList(character.Species)})";
}
