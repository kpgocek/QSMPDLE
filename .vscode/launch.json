{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "QSMPDLE.Web (http)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/web/bin/Debug/net10.0/QSMPDLE.Web.dll",
            "cwd": "${workspaceFolder}/web",
            "launchSettingsProfile": "http",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "stopAtEntry": false
        },
        {
            "name": ".NET Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
